# JetBrains IDEs (IntelliJ IDEA, WebStorm, DataGrip, ...)
# Reference: https://intellij-support.jetbrains.com/hc/en-us/articles/206544839
# Shared project settings in .idea stay tracked; only user-specific, generated and sensitive files are ignored.
# The **/ prefix applies every rule to the root project and to all modules (Api, Client, ...),
# so module .gitignore files carry no IntelliJ rules of their own.

# User-specific stuff
**/.idea/**/workspace.xml
**/.idea/**/tasks.xml
**/.idea/**/usage.statistics.xml
**/.idea/**/shelf/
**/.idea/**/httpRequests/
**/.idea/**/caches/
*.iws

# Spelling dictionaries are shared with the team and always tracked
!**/.idea/**/dictionaries/
!**/.idea/**/dictionaries/**

# Plugin user-specific state (AWS Toolkit, SonarLint, GitHub Copilot, Mongo Explorer, JIRA)
**/.idea/**/aws.xml
**/.idea/**/awsToolkit.xml
**/.idea/**/sonarlint/
**/.idea/**/copilot*
**/.idea/**/mongoSettings.xml
atlassian-ide-plugin.xml

# Generated files
**/.idea/**/contentModel.xml
**/.idea/**/libraries/
out/

# Sensitive or high-churn files (dataSources.xml is shared, its local credentials and caches are not)
**/.idea/**/dataSources/
**/.idea/**/dataSources.ids
**/.idea/**/dataSources.local.xml
**/.idea/**/sqlDataSources.xml
**/.idea/**/dynamic.xml
**/.idea/**/uiDesigner.xml
**/.idea/**/dbnavigator.xml

# Maven auto-import regenerates these module files from the poms, so they are not tracked
**/.idea/**/compiler.xml
**/.idea/**/jarRepositories.xml
**/.idea/**/modules.xml
*.iml

# secrets
**/env.properties
**/.env
**/dev.eveassist.com.crt
**/dev.eveassist.com.key
**/password.txt

# log files
**/*.log