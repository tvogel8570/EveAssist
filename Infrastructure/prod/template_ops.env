# Identifiers of EveAssist's own AWS setup, used by the commands in documentation/runbooks/ and by Infrastructure/prod/alarms.sh.
# Copy to ops.env in this folder and fill in the values; ops.env is git-ignored, so none of them is in the public repository.
# Load it before running a command from a runbook:   set -a; . Infrastructure/prod/ops.env; set +a
# These are identifiers, never secrets: no password, key or token belongs in this file (those stay in Secrets Manager).
# Every value can be looked up again from AWS with the admin profile; the command is next to each name. Every aws command run from the
# development computer names the profile (--profile EveAssist-admin), so nothing depends on the default profile or on AWS_PROFILE.
# Sign in first: aws sso login --profile EveAssist-admin

# aws sts get-caller-identity --profile EveAssist-admin --query Account --output text
EVEASSIST_ACCOUNT_ID=
# aws ec2 describe-instances --profile EveAssist-admin --filters Name=tag:Name,Values=eveassist-prod Name=instance-state-name,Values=running --query 'Reservations[].Instances[].InstanceId' --output text
EVEASSIST_INSTANCE_ID=
# aws rds describe-db-instances --profile EveAssist-admin --db-instance-identifier eveassist-prod --query 'DBInstances[0].Endpoint.Address' --output text
EVEASSIST_RDS_HOST=
# aws rds describe-db-instances --profile EveAssist-admin --db-instance-identifier eveassist-prod --query 'DBInstances[0].MasterUserSecret.SecretArn' --output text
EVEASSIST_RDS_MASTER_SECRET_ARN=
# aws ec2 describe-security-groups --profile EveAssist-admin --filters Name=group-name,Values=eveassist-ec2 --query 'SecurityGroups[0].GroupId' --output text
EVEASSIST_EC2_SG=
# aws ec2 describe-security-groups --profile EveAssist-admin --filters Name=group-name,Values=eveassist-rds --query 'SecurityGroups[0].GroupId' --output text
EVEASSIST_RDS_SG=
# aws ec2 describe-addresses --profile EveAssist-admin --query 'Addresses[?InstanceId==`'$EVEASSIST_INSTANCE_ID'`].[PublicIp,AllocationId]' --output text
EVEASSIST_ELASTIC_IP=
EVEASSIST_EIP_ALLOCATION=
# aws route53 list-hosted-zones-by-name --profile EveAssist-admin --dns-name eveassist.net --query 'HostedZones[0].Id' --output text   (without the /hostedzone/ prefix)
EVEASSIST_ZONE_ID=
# aws kms describe-key --profile EveAssist-admin --key-id alias/eveassist-token-key --query KeyMetadata.KeyId --output text
EVEASSIST_KMS_KEY_ID=
# the support access role's trust policy: the account's SSO administrator role
# aws iam list-roles --profile EveAssist-admin --path-prefix /aws-reserved/sso.amazonaws.com/ --query 'Roles[?contains(RoleName, `AdministratorAccess`)].Arn' --output text
EVEASSIST_SSO_ADMIN_ROLE_ARN=
# the database's resource id, for rds-db:connect (not its name)
# aws rds describe-db-instances --profile EveAssist-admin --db-instance-identifier eveassist-prod --query 'DBInstances[0].DbiResourceId' --output text
EVEASSIST_RDS_RESOURCE_ID=
