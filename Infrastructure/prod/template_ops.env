# Identifiers of EveAssist's own AWS setup, used by the commands in documentation/runbooks/ and by Infrastructure/prod/alarms.sh.
# Copy to ops.env in this folder and fill in the values; ops.env is git-ignored, so none of them is in the public repository.
# Load it before running a command from a runbook:   set -a; . Infrastructure/prod/ops.env; set +a
# These are identifiers, never secrets: no password, key or token belongs in this file (those stay in Secrets Manager).
# Every value can be looked up again from AWS with the admin profile; the command is next to each name.

# aws sts get-caller-identity --query Account --output text
EVEASSIST_ACCOUNT_ID=
# aws ec2 describe-instances --filters Name=tag:Name,Values=eveassist-prod Name=instance-state-name,Values=running --query 'Reservations[].Instances[].InstanceId' --output text
EVEASSIST_INSTANCE_ID=
# aws rds describe-db-instances --db-instance-identifier eveassist-prod --query 'DBInstances[0].Endpoint.Address' --output text
EVEASSIST_RDS_HOST=
# aws rds describe-db-instances --db-instance-identifier eveassist-prod --query 'DBInstances[0].MasterUserSecret.SecretArn' --output text
EVEASSIST_RDS_MASTER_SECRET_ARN=
# aws ec2 describe-security-groups --filters Name=group-name,Values=eveassist-ec2 --query 'SecurityGroups[0].GroupId' --output text
EVEASSIST_EC2_SG=
# aws ec2 describe-security-groups --filters Name=group-name,Values=eveassist-rds --query 'SecurityGroups[0].GroupId' --output text
EVEASSIST_RDS_SG=
# aws ec2 describe-addresses --query 'Addresses[?InstanceId==`'$EVEASSIST_INSTANCE_ID'`].[PublicIp,AllocationId]' --output text
EVEASSIST_ELASTIC_IP=
EVEASSIST_EIP_ALLOCATION=
# aws route53 list-hosted-zones-by-name --dns-name eveassist.net --query 'HostedZones[0].Id' --output text   (without the /hostedzone/ prefix)
EVEASSIST_ZONE_ID=
# aws kms describe-key --key-id alias/eveassist-token-key --query KeyMetadata.KeyId --output text
EVEASSIST_KMS_KEY_ID=
