# Prod proxy: ends TLS with Let's Encrypt certificates and forwards to the app and to Keycloak. The names come from
# prod.env. Caddy sets X-Forwarded-For, -Proto and -Host itself and discards any the client sent.
# Access log: the privacy policy (privacy.html, "The web server's log") promises what it holds, that it is used only to
# find and stop attacks, and that it is kept for 14 days (the retention of the log group /eveassist/prod/proxy, set in
# compose.yaml). Change that page before logging anything more here.
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}

# One access line per request: time, client address, method, host, path, status, size, duration and the browser's
# User-Agent. Every request and response header is dropped (cookies and Authorization included), and the User-Agent is
# added back as its own field. The query string is kept on the app's host for spotting attack payloads, minus the
# OAuth parameters of the sign-in callback. The Route 53 health check of /privacy is not logged.
(access_log) {
	@healthcheck {
		path /privacy
		header User-Agent *Route53-Health-Check*
	}
	log_skip @healthcheck
	log_append user_agent {http.request.header.User-Agent}
	log {
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>uri query {
					delete code
					delete state
					delete session_state
					delete iss
				}
			}
		}
	}
}

{$DOMAIN} {
	import security_headers
	import access_log
	encode zstd gzip
	reverse_proxy app:7444
}

{$AUTH_DOMAIN} {
	import security_headers
	# The sign-in pages carry session codes in every query string, so on this host the whole query is dropped.
	log {
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				request>uri regexp \?.* ""
			}
		}
	}
	log_append user_agent {http.request.header.User-Agent}
	# Allowlist: only the EveAssist realm's endpoints (sign-in, the callback from EVE, keys) and the theme files its
	# pages load are forwarded. Everything else, including the admin console, the master realm and /metrics, answers
	# 404 from the internet. The operator reaches those through a tunnel to the instance
	# (see documentation/runbooks/initial-deployment.md). A new Keycloak path stays hidden until it is added here.
	@public path /realms/EveAssist /realms/EveAssist/* /resources/*
	handle @public {
		encode zstd gzip
		reverse_proxy keycloak:8080
	}
	handle {
		respond 404
	}
}
