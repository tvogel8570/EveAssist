# Prod proxy: ends TLS with Let's Encrypt certificates and forwards to the app and to Keycloak. The names come from
# prod.env. Caddy sets X-Forwarded-For, -Proto and -Host itself and discards any the client sent.
# There is no `log` directive on purpose: Caddy then writes no access log, and the privacy policy (privacy.html) says so.
# Turning access logs on needs that page changed first.
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}

{$DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy app:7444
}

{$AUTH_DOMAIN} {
	import security_headers
	# Allowlist: only the EveAssist realm's endpoints (sign-in, the callback from EVE, keys) and the theme files its
	# pages load are forwarded. Everything else, including the admin console, the master realm and /metrics, answers
	# 404 from the internet. The operator reaches those through a tunnel to the instance
	# (see documentation/runbooks/initial-deployment.md). A new Keycloak path stays hidden until it is added here.
	@public path /realms/EveAssist /realms/EveAssist/* /resources/*
	handle @public {
		encode zstd gzip
		reverse_proxy keycloak:8080
	}
	handle {
		respond 404
	}
}
