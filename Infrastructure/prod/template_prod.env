# Copy to prod.env on the instance (the real file is not in git) and fill in RDS_HOST, the RDS endpoint (EVEASSIST_RDS_HOST in ops.env).
# Prod settings that are not secret. Read by start.sh. Secrets come from Secrets Manager, image digests from images.env.
AWS_DEFAULT_REGION=us-west-2
DOMAIN=eveassist.net
AUTH_DOMAIN=auth.eveassist.net
ACME_EMAIL=cass@vogelware.com
RDS_HOST=
EVE_KMS_KEY_ID=alias/eveassist-token-key
