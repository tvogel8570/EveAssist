# Copy to images.env on the instance (not in git) and fill in the digests of the images to run. A digest, not a tag,
# so that what runs is exactly what was tested. `docker buildx build ... --push` prints it, or: aws ecr describe-images
APP_IMAGE=$EVEASSIST_ACCOUNT_ID.dkr.ecr.us-west-2.amazonaws.com/eveassist-app@sha256:
KEYCLOAK_IMAGE=$EVEASSIST_ACCOUNT_ID.dkr.ecr.us-west-2.amazonaws.com/eveassist-keycloak@sha256:
